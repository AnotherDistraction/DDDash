# Anthropic Claude API
ANTHROPIC_API_KEY=sk-ant-...

# Reddit (https://www.reddit.com/prefs/apps)
REDDIT_CLIENT_ID=your_client_id
REDDIT_CLIENT_SECRET=your_client_secret
REDDIT_USER_AGENT=MarketDigest/1.0 by YourUsername

# StockTwits (https://api.stocktwits.com/developers/apps)
STOCKTWITS_ACCESS_TOKEN=your_access_token

# GuruFocus (https://www.gurufocus.com/api)
GURUFOCUS_API_KEY=your_api_key

# FRED - Federal Reserve Economic Data (https://fred.stlouisfed.org/docs/api/api_key.html)
FRED_API_KEY=your_api_key

# X / Twitter API v2 (https://developer.twitter.com/en/portal/dashboard)
X_BEARER_TOKEN=your_bearer_token
